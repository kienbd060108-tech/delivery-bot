{
	"schemaVersion": 1,
	"id": "deliverybot",
	"version": "${version}",
	"name": "Automated Delivery Bot",
	"description": "Fully automated client-side delivery job bot for Minecraft 26.2 (Fabric).",
	"authors": [
		"DeliveryBot Dev"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.example.delivery.DeliveryBotMod"
		],
		"modmenu": [
			"com.example.delivery.gui.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "deliverybot.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}